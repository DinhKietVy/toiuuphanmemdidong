data/processed/extracted/
data/processed/dataset/*.npy

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Benchmark APK set (download via scripts/prepare_benchmark_apks.py; keep bench_apks.csv)
data/bench_apks/*.apk
data/bench_apks/*.part
