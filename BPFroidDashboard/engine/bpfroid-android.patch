+// BPFroid: alerts also go to the file named by BPFROID_ALERT_FILE (if set), so consumers
+// don't have to scan tracee's full output. processEvent runs on a single goroutine.
+var dropperAlertFile *os.File
+var dropperAlertFileOpened bool
+
+func dropperPayloadType(magic uint32) string {
+	switch magic {
+	case 0x464c457f:
+		return "ELF"
+	case 0x04034b50:
+		return "ZIP/APK"
+	case 0x0a786564:
+		return "DEX"
+	}
+	return ""
+}
+
+func (t *Tracee) reportDropperAlert(ctx *context, args map[argTag]interface{}) {
+	tags := t.EncParamName[ctx.EventID%2]
+	magic, _ := args[tags["magic"]].(uint32)
+	payloadType := dropperPayloadType(magic)
+	if payloadType == "" {
+		return
+	}
+	path, _ := args[tags["pathname"]].(string)
+	dev, _ := args[tags["dev"]].(uint32)
+	inode, _ := args[tags["inode"]].(uint64)
+	comm := strings.ReplaceAll(string(bytes.TrimRight(ctx.Comm[:], "\x00")), " ", "_")
+
+	// path last: it is the only field that may contain spaces.
+	emitBPFroidAlert(fmt.Sprintf("BPFROID_DROPPER_ALERT type=%s uid=%d pid=%d comm=%s dev=%d inode=%d path=%s\n",
+		payloadType, ctx.Uid, ctx.HostPid, comm, dev, inode, path))
+}
+
+const firstAppUID = 10000
+
+// Only privilege *gains* are reported: becoming root, or an app uid turning into a system uid.
+// Dropping privileges (zygote 0 -> app uid, daemons switching to their service uid) is normal.
+func isPrivilegeEscalation(prevUID, curUID uint32) bool {
+	if curUID == 0 && prevUID != 0 {
+		return true
+	}
+	return prevUID >= firstAppUID && curUID < firstAppUID
+}
+
+func (t *Tracee) reportPrivEscAlert(ctx *context, args map[argTag]interface{}) {
+	tags := t.EncParamName[ctx.EventID%2]
+	prevUID, ok1 := args[tags["prev_uid"]].(uint32)
+	curUID, ok2 := args[tags["cur_uid"]].(uint32)
+	if !ok1 || !ok2 || !isPrivilegeEscalation(prevUID, curUID) {
+		return
+	}
+	comm := strings.ReplaceAll(string(bytes.TrimRight(ctx.Comm[:], "\x00")), " ", "_")
+	emitBPFroidAlert(fmt.Sprintf("BPFROID_PRIVESC_ALERT prev_uid=%d uid=%d pid=%d tid=%d comm=%s\n",
+		prevUID, curUID, ctx.HostPid, ctx.HostTid, comm))
+}
+
+func emitBPFroidAlert(line string) {
+	fmt.Print(line)
+
+	if !dropperAlertFileOpened {
+		dropperAlertFileOpened = true
+		if p := os.Getenv("BPFROID_ALERT_FILE"); p != "" {
+			f, err := os.OpenFile(p, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
+			if err != nil {
+				fmt.Fprintf(os.Stderr, "BPFroid: cannot open alert file %s: %v\n", p, err)
+			} else {
+				dropperAlertFile = f
+			}
+		}
+	}
+	if dropperAlertFile != nil {
+		dropperAlertFile.WriteString(line)
+	}
+}
